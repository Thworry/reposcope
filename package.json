{
  "name": "reposcope",
  "version": "0.3.0",
  "description": "Bilingual, browser-side quality reports for public GitHub repositories",
  "private": true,
  "license": "MIT",
  "homepage": "https://thworry.github.io/reposcope/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thworry/reposcope.git"
  },
  "bugs": {
    "url": "https://github.com/Thworry/reposcope/issues"
  },
  "keywords": [
    "github",
    "static-analysis",
    "code-quality",
    "open-source"
  ],
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:server": "vitest run --config vitest.server.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.build.json",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node server-dist/server/index.js",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test",
    "check:bundle": "node --test scripts/check-bundle-size.test.mjs && node scripts/check-bundle-size.mjs",
    "check:lighthouse": "node --test scripts/check-lighthouse.test.mjs && node scripts/check-lighthouse.mjs",
    "check:deep-analysis-eval": "node --test scripts/check-deep-analysis-eval.test.mjs && node scripts/check-deep-analysis-eval.mjs",
    "gate:deep-analysis": "node scripts/check-deep-analysis-eval.mjs --require-scorecard",
    "smoke:copilot": "tsx scripts/smoke-copilot-panel.ts",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm test:server && pnpm typecheck:server && pnpm check:deep-analysis-eval && pnpm build"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "@github/copilot-sdk": "1.0.11",
    "@hono/node-server": "2.1.1",
    "@lezer/common": "1.5.2",
    "@lezer/python": "1.1.19",
    "hono": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "chrome-launcher": "1.2.1",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
